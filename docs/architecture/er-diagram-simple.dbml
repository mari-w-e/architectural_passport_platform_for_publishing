Project literary_platform_simple {
  database_type: 'PostgreSQL'
  Note: 'Упрощённая модель данных: только основные сущности, ключи и связи.'
}

enum payment_status {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum chapter_status {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum notification_status {
  PENDING
  SENT
  FAILED
}

enum user_role {
  USER
  MODERATOR
}

Table users {
  id uuid [pk]
  email varchar [unique, not null]
  role user_role [not null, default: 'USER']
}

Table works {
  id uuid [pk]
  author_id uuid [not null]
  title varchar [not null]
  description varchar(1500) [not null]
  genres "varchar(255)[]" [not null]
  tags "varchar(255)[]"
}

Table chapters {
  id uuid [pk]
  work_id uuid [not null]
  status chapter_status [not null, default: 'DRAFT']
  title varchar(255) [not null]
  content text [not null]
}

Table comments {
  id uuid [pk]
  work_id uuid [not null]
  author_id uuid [not null]
  text text [not null]
}

Table favorites {
  user_id uuid [not null]
  work_id uuid [not null]

  indexes {
    (user_id, work_id) [pk]
  }
}

Table reading_progress {
  user_id uuid [not null]
  work_id uuid [not null]
  chapter_id uuid [not null]
  position float [not null]


  indexes {
    (user_id, work_id) [pk]
  }
}

Table subscriptions {
  subscriber_id uuid [not null]
  author_id uuid [not null]

  indexes {
    (subscriber_id, author_id) [pk]
  }
}

Table promotions {
  id uuid [pk]
  work_id uuid [not null]
  customer_id uuid [not null]
  status varchar [note: 'PENDING_PAYMENT, ACTIVE, EXPIRED, CANCELLED']
  duration_days smallint [not null]
  starts_at timestamp
}

Table payments {
  id uuid [pk]
  promotion_id uuid [not null]
  amount decimal(12,2) [not null]
  status payment_status [not null, default: 'PENDING']
}

Table reports {
  id uuid [pk]
  reporter_id uuid [not null]
  target_type varchar [note: 'WORK, CHAPTER, COMMENT, USER']
  target_id uuid [note: 'Без внешнего ключа: цель бывает разного типа']
  resolved_by uuid [note: 'Модератор, решивший проблему']
}

Table notifications {
  id uuid [pk]
  user_id uuid [not null]
  payload jsonb [not null]
  status notification_status [not null, default: 'PENDING']
}

Ref: works.author_id > users.id
Ref: chapters.work_id > works.id
Ref: comments.work_id > works.id
Ref: comments.author_id > users.id

Ref: favorites.user_id > users.id
Ref: favorites.work_id > works.id
Ref: reading_progress.user_id > users.id
Ref: reading_progress.work_id > works.id
Ref: reading_progress.chapter_id > chapters.id
Ref: subscriptions.subscriber_id > users.id
Ref: subscriptions.author_id > users.id

Ref: promotions.work_id > works.id
Ref: promotions.customer_id > users.id
Ref: payments.promotion_id > promotions.id

Ref: reports.reporter_id > users.id
Ref: notifications.user_id > users.id
